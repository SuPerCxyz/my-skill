{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyStack Test Execution Plan",
  "type": "object",
  "required": ["impact_analysis", "authorization", "cases"],
  "properties": {
    "impact_analysis": {
      "type": "object",
      "required": ["id", "obligations"],
      "properties": {
        "id": {"type": "string"},
        "obligations": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "authorization": {
      "type": "object",
      "required": ["scope", "destructive_operations"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "destructive_operations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "scenario_key",
        "title",
        "requirement_summary",
        "domain",
        "objective",
        "actions",
        "verification",
        "log_requirement",
        "log_targets",
        "cleanup_policy"
        ,"impact_refs"
        ,"capability_status"
        ,"destructive_operations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "scenario_key": {"type": "string"},
        "title": {"type": "string", "minLength": 2, "maxLength": 40},
        "requirement_summary": {"type": "string", "minLength": 6, "maxLength": 60},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "impact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "capability_status": {
          "enum": ["SUPPORTED", "CONDITIONAL", "UNSUPPORTED", "UNKNOWN"]
        },
        "destructive_operations": {"type": "array", "items": {"type": "string"}},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/action"}
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/check"}
        },
        "log_requirement": {"enum": ["required", "optional", "none"]},
        "log_targets": {"type": "array"},
        "cleanup_policy": {"type": "string"}
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "phase", "kind", "description", "command", "expected"],
      "properties": {
        "id": {"type": "string"},
        "phase": {
          "enum": [
            "DISCOVER_CASE_CONTEXT", "OPEN_LOG_WINDOW",
            "SNAPSHOT_SERVICE_INSTANCES", "PREPARE", "EXECUTE", "WAIT",
            "VERIFY", "CLOSE_LOG_WINDOW", "COLLECT_LOGS",
            "COLLECT_RESOURCES", "APPLY_CLEANUP_POLICY"
          ]
        },
        "kind": {
          "enum": ["openstack", "kubectl", "env_access", "assertion", "cleanup"]
        },
        "description": {"type": "string", "minLength": 1},
        "command": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {
          "type": "object",
          "required": ["return_codes"],
          "properties": {
            "return_codes": {
              "type": "array", "minItems": 1,
              "items": {"type": "integer", "minimum": 0, "maximum": 255}
            }
          },
          "additionalProperties": false
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "capture": {"type": "object"},
        "cleanup_resources": {"type": "array", "items": {"type": "string"}},
        "destructive_operation": {"type": "string"}
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "check_type", "required", "expected", "evaluator"],
      "properties": {
        "id": {"type": "string"},
        "check_type": {"enum": ["functional", "diagnostic", "cleanup"]},
        "required": {"type": "boolean"},
        "check": {"type": "string"},
        "expected": {"type": "string"},
        "evaluator": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["action_status", "json_path", "regex", "manual"]}
          },
          "additionalProperties": true
        }
      }
    }
  }
}
